# LiveKit Cloud project credentials — from your project settings at cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Groq API key — used for the LLM (Qwen3), via the OpenAI-compatible plugin
GROQ_API_KEY=

# Soniox API key — used for TTS
SONIOX_API_KEY=

# Deepgram API key — used for STT (Flux), read directly by the plugin
DEEPGRAM_API_KEY=

# Optional — Slack Incoming Webhook URL. If unset, the notifySupportTeam tool
# still succeeds but skips sending the Slack message.
SLACK_WEBHOOK_URL=