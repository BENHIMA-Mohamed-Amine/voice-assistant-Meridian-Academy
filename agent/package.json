    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@livekit/agents": "^1.6.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@livekit/agents-plugin-deepgram": "~1.7.1",
    "@livekit/agents-plugin-openai": "~1.7.1",
    "@livekit/agents-plugin-silero": "^1.7.1",
    "@livekit/agents-plugin-soniox": "~1.7.1",
